    <string name="changelog_v2_0_3">Changelog v2.0.3 Raven\'s Revenge</string>
    <string name="v2_0_3_updates">v2.0.3 Updates:</string>
    <string name="v2_0_3_highlight_1">Direct In-App 1-Click Update: Download and install new updates seamlessly directly within the app with live download progress, error retry, and automatic installer launch.</string>
    <string name="v2_0_3_highlight_2">Search Results State Persistence: Back-navigation from video details now perfectly preserves active search queries, results grid, and remote focus position.</string>
    <string name="v2_0_3_highlight_3">Enhanced Android TV D-Pad Experience: Smart auto-focus and high-contrast visual indicators for update dialogs and browsing grids.</string>
    <string name="changelog_v2_0_2">Changelog v2.0.2 Raven\'s Revenge</string>
    <string name="v2_0_2_updates">v2.0.2 Updates:</string>
    <string name="v2_0_2_highlight_1">High-Definition TV Posters &amp; Backdrops: Upgraded TMDB and CDN poster resolutions up to 780p and backdrops to 1080p widescreen for crystal-clear clarity on Android TV and 4K displays.</string>
    <string name="v2_0_2_highlight_2">Hardware-Adaptive Memory Protection: Dynamic resolution scaling ensures smooth navigation and prevents OutOfMemory stalls on budget Android TV boxes.</string>
    <string name="v2_0_2_highlight_3">Enhanced Image Scraping Fidelity: Intelligent responsive srcset candidate extraction guarantees sharp, high-detail movie and series posters.</string>
    <string name="changelog_v2_0_1">Changelog v2.0.1 Raven\'s Revenge</string>
    <string name="v2_0_1_updates">v2.0.1 Updates:</string>
    <string name="v2_0_1_highlight_1">Hardware-Accelerated Video: Restored GPU hardware decoders for smooth 1080p streaming without frame skips or CPU overheating.</string>
    <string name="v2_0_1_highlight_2">Cinematic Audio Focus: Automatic pause/duck during phone calls and alarms, with clean Android 12+ audio routing.</string>
    <string name="v2_0_1_highlight_3">Screen-Off Power Saving: Automatic playback pause when the device screen is locked outside PiP mode.</string>
    <string name="v2_0_1_highlight_4">Cast Engine Stability: Fixed main-thread Google Cast SDK initialization on app startup.</string>
    <string name="v2_0_1_highlight_5">Studio-Grade Categories UI: Premium interface for Manage Home Categories without emojis, featuring studio accent bars and bilingual localization.</string>
    <string name="changelog_v2_0">Changelog v2.0 Raven\'s Revenge</string>
    <string name="v2_0_updates">v2.0 Updates:</string>
    <string name="v1_9_7_updates">v1.9.7 Updates:</string>
    <string name="promo_highlight_1">Restored TV Series &amp; Anime Episodes: Full universal episode resolution and playback.</string>
    <string name="promo_highlight_2">Multi-Season Grouping &amp; Auto-Sort: Automatic season classification and episode sequence sorting.</string>
    <string name="promo_highlight_3">Universal Episode Extraction Engine: Deep extraction for modern layout structures (.gmr-listseries).</string>
    <string name="promo_highlight_4">Multi-Provider Mirror Auto-Healing: Discover and resolve fresh video mirrors automatically.</string>
    <string name="promo_highlight_5">Instant Dead Stream Failover: Sub-2s dead stream detection with rapid mirror recovery.</string>

