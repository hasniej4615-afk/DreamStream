    <string name="v1_9_5_updates">v1.9.5 Updates:</string>
    <string name="fixed_locked_text_ui">Fixed misleading \"Locked\" text in Manage Home Categories.</string>
    <string name="fixed_cast_7_bugs">Fixed 7 Chromecast bugs: progress saving, session resume, quality selection, and crash on non-GMS devices.</string>
    <string name="improved_tv_buffering">Improved TV buffering: larger buffer (5 min) and auto 720p to prevent mid-playback stalls.</string>
    <string name="added_tv_home_channel">Added Android TV Home Screen channel with featured movies.</string>
    <string name="fixed_category_pagination">Fixed category pagination and paths to fetch more items.</string>
    <string name="fixed_cast_state">Fixed Chromecast getting stuck on previous video when navigating.</string>
