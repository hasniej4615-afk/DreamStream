    <string name="changelog_v1_9_7">Changelog v1.9.7</string>
    <string name="v1_9_6_updates">v1.9.6 Updates:</string>
    <string name="added_pencuri_adaptive_domain">Added self-healing domain discovery for Malaysia catalog (auto-recovers when domains change).</string>
    <string name="fixed_player_dead_stream_ui">Fixed black-screen player freeze: added sub-2s dead stream detection and dedicated error recovery screen.</string>
    <string name="fixed_movie_state_bleed">Fixed stale server URL bleed-through and false rotation signals when switching movies.</string>
    <string name="optimized_subtitle_loading">Optimized background subtitle extraction with fast-break on inactive provider keys.</string>
