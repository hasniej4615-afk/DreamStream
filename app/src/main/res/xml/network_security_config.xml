<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- PRODUCTION CONFIG: Trust both system and user certificates for enterprise/office networks, allow cleartext for mirrors -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">indostream.xyz</domain>
        <domain includeSubdomains="true">iplayerhls.com</domain>
        <domain includeSubdomains="true">iplayer.fun</domain>
        <domain includeSubdomains="true">amt1.pro</domain>
        <domain includeSubdomains="true">amt2.pro</domain>
        <domain includeSubdomains="true">amt3.pro</domain>
        <domain includeSubdomains="true">amt4.pro</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!-- Specific domains that might have user cert requirements in debug -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
